# Copy to .env if you prefer environment variables over editing config.yaml.
# Real environment variables always win over both.

# --- LM Studio -----------------------------------------------------------------
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_ADMIN_URL=http://127.0.0.1:1234/api/v0
LMSTUDIO_API_KEY=lm-studio
# Model used when nothing is selected in the UI dropdown (null → first loaded chat model)
BA_MODEL=
# Embedding model served by LM Studio; leave empty for BM25-only retrieval
BA_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# auto | json_schema | function_calling | prompt
BA_STRUCTURED_METHOD=auto
BA_MAX_CONCURRENCY=1
BA_REQUEST_TIMEOUT_S=600

# --- Strata (optional: set BA_PROVIDER=strata) -----------------------------------
BA_PROVIDER=lmstudio
STRATA_BASE_URL=http://127.0.0.1:47831/v1
STRATA_MODEL=q2_0

# --- Server --------------------------------------------------------------------
BA_HOST=127.0.0.1
BA_PORT=8765
BA_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# --- Workflow budgets ------------------------------------------------------------
BA_MAX_QUESTIONS_PER_SUBJECT=2
BA_MAX_REVIEW_ROUNDS=2

# --- Optional external Mermaid renderer (sends your spec to that host!) ----------
# BA_KROKI_URL=https://kroki.io
